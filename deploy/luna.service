[Unit]
Description=Luna Collections frontend and backend
After=network.target

[Service]
Type=simple
User=app
Group=app
WorkingDirectory=/srv/test/shoe-ecommerce
Environment=ENV_FILE=/srv/test/shoe-ecommerce/backend/.env
ExecStart=/srv/test/shoe-ecommerce/run.sh
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
