# =============================================================================
# Luna Collections — environment configuration
# Copy to .env and adjust:  cp .env.example .env
# Loaded by the Go API and by ../run.sh at the project root.
# =============================================================================

# --- Ports (used by run.sh) ---
FRONTEND_PORT=4204
BACKEND_PORT=8084

# --- Angular dev server ---
FRONTEND_ALLOWED_HOSTS=localhost,127.0.0.1,tri-data-lab,beauty.zenu.co.ke
FRONTEND_HMR=false
FRONTEND_LIVE_RELOAD=false
FRONTEND_PREBUNDLE=false

# --- Application ---
APP_ENV=development

# --- Database mode ---
DATABASE_MODE=test

DATABASE_URL=

# --- SQLite (DATABASE_MODE=test) ---
SQLITE_PATH=./data/luna_collections.db

# --- PostgreSQL (DATABASE_MODE=production) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=luna
POSTGRES_PASSWORD=change_me
POSTGRES_DB=luna_collections
POSTGRES_SSLMODE=disable

# --- CORS ---
CORS_ORIGINS=http://localhost:4204,http://127.0.0.1:4204

# --- CMS admin (JWT) ---
JWT_SECRET=change-me-use-a-long-random-secret-in-production
JWT_EXPIRY_HOURS=24
CMS_ADMIN_EMAIL=admin@lunacollections.local
CMS_ADMIN_PASSWORD=luna-admin-change-me
CMS_ADMIN_NAME='Site Admin'
